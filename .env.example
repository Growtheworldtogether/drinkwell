APP_NAME=DRinkWeLL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
DRINKWELL_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0.16+ or MariaDB 10.3+. Use "mysql" even on MariaDB. On cPanel the database and user names start with your account name.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drinkwell
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real SMTP (SPEC 5.4). Gmail app password (smtp.gmail.com:587) or a free tier such as Brevo.
# The log mailer is allowed only when APP_ENV=local.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=...
MAIL_PASSWORD=...
# Port 587 uses MAIL_SCHEME=smtp (STARTTLS). Port 465 needs MAIL_SCHEME=smtps.
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=no-reply@yourdomain.tld
MAIL_FROM_NAME="${APP_NAME}"     # fallback only; the sender name shown to recipients is brand.name (see 11.6)

# First admin, created by the seeder.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Map tiles are fetched once by the server and cached on disk. Change the source here if you like.
MAP_TILE_UPSTREAM=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Security (SPEC 17). All optional.
# Addresses of the load balancer or CDN in front of the site, comma separated, or * for the one directly in front.
TRUSTED_PROXIES=
# Start false, watch the browser console for CSP reports, then set true.
CSP_ENFORCE=false
# Reject passwords found in public breaches (needs outbound HTTPS).
CHECK_BREACHED_PASSWORDS=false
# Comma separated addresses allowed to reach /admin. Empty means any address.
ADMIN_IP_ALLOWLIST=
ADMIN_IDLE_MINUTES=60

# Password for the seeded demo account arthur.pendelton@example.test. Leave empty to make that account unable to sign in.
# Testing only: show sign-in, reset and withdrawal codes on the page instead of needing the email.
DEMO_SHOW_CODES=false
DEMO_PASSWORD=
